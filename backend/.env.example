# Local/staging runtime configuration
PORT=3000
NODE_ENV=development

# PostgreSQL/Supabase staging connection.
# Never commit real credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Comma-separated allowed browser origins.
CORS_ORIGIN=https://sayjinblackbelt.github.io

# Supabase URL/keys are not required by the Node PostgreSQL adapter.
# Keep publishable/auth configuration separate from database credentials.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
